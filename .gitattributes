# Preserve canonical source receipts and the runtime icon-discovery snapshot.
.gitattributes text eol=lf
/assets/icons/ui/design/requested_icons.txt text eol=lf
# SolidCraft designs (.sc): a JSON document or a ZIP container, never Scala source, so they
# stay out of GitHub's language statistics. Git's own text/binary detection handles both kinds.
*.sc -linguist-detectable

# Triya CAD 3D — merge policy for root files the fork owns outright.
# "merge=ours" keeps OUR version on every `git merge upstream/main` (needs
# `git config merge.ours.driver true`, see REPO-SETUP.md §4). Everything else merges normally.
README.md                               merge=ours
NOTICE                                  merge=ours
.github/workflows/triya-ci.yml          merge=ours
.github/workflows/triya-pages.yml       merge=ours
.github/workflows/upstream-sync.yml     merge=ours
# Everything under triya/ is ours by construction (upstream never has these paths).
