{
  "$defs": {
    "AnchorBolts": {
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dia_mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "count",
        "dia_mm"
      ],
      "type": "object"
    },
    "AngleSense": {
      "enum": [
        "clockwise_from_above",
        "counterclockwise_from_above"
      ],
      "type": "string"
    },
    "AngleZero": {
      "description": "What 0° means on the plan view.",
      "enum": [
        "plant_north",
        "plus_x",
        "plus_y"
      ],
      "type": "string"
    },
    "Attachment": {
      "description": "One nozzle, support or detail.",
      "oneOf": [
        {
          "properties": {
            "attach": {
              "$ref": "#/$defs/NozzleAttach",
              "default": "set_in"
            },
            "flange": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NozzleFlange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inside_projection_mm": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "nozzle",
              "type": "string"
            },
            "manway": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Manway"
                },
                {
                  "type": "null"
                }
              ]
            },
            "neck_thk_mm": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "neck_type": {
              "$ref": "#/$defs/NeckType",
              "default": "pipe"
            },
            "nps": {
              "description": "`\"4\"`, `\"1/2\"`, `\"24\"`.",
              "type": "string"
            },
            "pad": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Pad"
                },
                {
                  "type": "null"
                }
              ]
            },
            "projection": {
              "$ref": "#/$defs/Projection"
            },
            "schedule": {
              "description": "`\"STD\"`, `\"XS\"`, `\"80\"`; or give `neck_thk_mm`.",
              "type": [
                "string",
                "null"
              ]
            },
            "service": {
              "description": "Text for the nozzle schedule.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "nps",
            "projection"
          ],
          "type": "object"
        },
        {
          "description": "A horizontal vessel's saddle; the host is a cylinder.",
          "properties": {
            "anchor_bolts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnchorBolts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_plate": {
              "$ref": "#/$defs/Plate"
            },
            "contact_angle_deg": {
              "default": 120.0,
              "format": "double",
              "type": "number"
            },
            "height_mm": {
              "description": "Base to the vessel's bottom.",
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "saddle",
              "type": "string"
            },
            "rib_count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rib_thk_mm": {
              "format": "double",
              "type": "number"
            },
            "wear_plate": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WearPlate"
                },
                {
                  "type": "null"
                }
              ]
            },
            "web_thk_mm": {
              "format": "double",
              "type": "number"
            },
            "width_mm": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "width_mm",
            "height_mm",
            "web_thk_mm",
            "rib_count",
            "rib_thk_mm",
            "base_plate"
          ],
          "type": "object"
        },
        {
          "description": "A pattern of legs.",
          "properties": {
            "attach": {
              "$ref": "#/$defs/LegAttach",
              "default": "shell"
            },
            "base_plate": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Plate"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "leg",
              "type": "string"
            },
            "length_mm": {
              "format": "double",
              "type": "number"
            },
            "section": {
              "$ref": "#/$defs/LegSection"
            },
            "start_angle_deg": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "count",
            "section",
            "length_mm"
          ],
          "type": "object"
        },
        {
          "description": "A pattern of bracket (lug) supports.",
          "properties": {
            "bolt_holes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoltHoles"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bottom_plate": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Plate"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "gusset": {
              "$ref": "#/$defs/Gusset"
            },
            "kind": {
              "const": "bracket",
              "type": "string"
            },
            "top_plate": {
              "$ref": "#/$defs/Plate"
            }
          },
          "required": [
            "kind",
            "count",
            "gusset",
            "top_plate"
          ],
          "type": "object"
        },
        {
          "description": "Anchor-bolt chairs around a skirt.",
          "properties": {
            "bolt_dia_mm": {
              "format": "double",
              "type": "number"
            },
            "count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "gusset_thk_mm": {
              "format": "double",
              "type": "number"
            },
            "height_mm": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "anchor_chair",
              "type": "string"
            },
            "top_plate_thk_mm": {
              "format": "double",
              "type": "number"
            },
            "width_mm": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "count",
            "height_mm",
            "width_mm",
            "gusset_thk_mm",
            "top_plate_thk_mm",
            "bolt_dia_mm"
          ],
          "type": "object"
        },
        {
          "properties": {
            "inside": {
              "default": false,
              "type": "boolean"
            },
            "kind": {
              "const": "stiffening_ring",
              "type": "string"
            },
            "section": {
              "$ref": "#/$defs/RingSection"
            }
          },
          "required": [
            "kind",
            "section"
          ],
          "type": "object"
        },
        {
          "description": "A half-pipe coil wound on the shell; give `turns` or `end_axial_mm`.",
          "properties": {
            "end_axial_mm": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "half_pipe": {
              "default": true,
              "type": "boolean"
            },
            "hand": {
              "$ref": "#/$defs/Hand",
              "default": "rh"
            },
            "kind": {
              "const": "limpet_coil",
              "type": "string"
            },
            "pipe_nps": {
              "type": "string"
            },
            "pitch_mm": {
              "format": "double",
              "type": "number"
            },
            "schedule": {
              "type": "string"
            },
            "start_angle_deg": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "turns": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "pipe_nps",
            "schedule",
            "pitch_mm"
          ],
          "type": "object"
        },
        {
          "properties": {
            "hole_dia_mm": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "lifting_lug",
              "type": "string"
            },
            "pad": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Pad"
                },
                {
                  "type": "null"
                }
              ]
            },
            "plate": {
              "$ref": "#/$defs/LugPlate"
            },
            "style": {
              "$ref": "#/$defs/LugStyle"
            }
          },
          "required": [
            "kind",
            "style",
            "plate",
            "hole_dia_mm"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "insulation_ring",
              "type": "string"
            },
            "segments": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "thk_mm": {
              "format": "double",
              "type": "number"
            },
            "width_mm": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "width_mm",
            "thk_mm",
            "segments"
          ],
          "type": "object"
        },
        {
          "properties": {
            "count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "clip",
              "type": "string"
            },
            "plate": {
              "$ref": "#/$defs/Plate"
            },
            "purpose": {
              "$ref": "#/$defs/ClipPurpose"
            }
          },
          "required": [
            "kind",
            "plate",
            "count",
            "purpose"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "angle_deg": {
          "default": 0.0,
          "description": "Azimuth per `global.angle_zero` / `angle_sense`.",
          "format": "double",
          "type": "number"
        },
        "axial": {
          "$ref": "#/$defs/Axial"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "$ref": "#/$defs/Flags",
          "description": "Set by the generator."
        },
        "frame": {
          "$ref": "#/$defs/Frame",
          "default": {
            "type": "radial"
          }
        },
        "host": {
          "description": "The element it sits on (`Element::id`).",
          "type": "string"
        },
        "id": {
          "description": "`N1`, `M1`, `L1`, … (unique across elements and attachments).",
          "type": "string"
        },
        "material": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_key": {
          "description": "Keys into a `TableSet` row.",
          "type": [
            "string",
            "null"
          ]
        },
        "standard_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "host",
        "axial"
      ],
      "type": "object"
    },
    "Axial": {
      "description": "Where along the axis an attachment sits.",
      "properties": {
        "mm": {
          "format": "double",
          "type": "number"
        },
        "ref": {
          "$ref": "#/$defs/AxialRef"
        }
      },
      "required": [
        "ref",
        "mm"
      ],
      "type": "object"
    },
    "AxialRef": {
      "oneOf": [
        {
          "const": "datum",
          "description": "From the datum: the elevation stays put when elements are re-stacked.",
          "type": "string"
        },
        {
          "const": "host_from",
          "description": "From the host element's start node: it moves with the host.",
          "type": "string"
        }
      ]
    },
    "BaseRing": {
      "properties": {
        "id_mm": {
          "format": "double",
          "type": "number"
        },
        "od_mm": {
          "format": "double",
          "type": "number"
        },
        "thickness_mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "od_mm",
        "id_mm",
        "thickness_mm"
      ],
      "type": "object"
    },
    "BoltHoles": {
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dia_mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "count",
        "dia_mm"
      ],
      "type": "object"
    },
    "ClipPurpose": {
      "enum": [
        "ladder",
        "platform",
        "pipe_support",
        "earthing",
        "nameplate"
      ],
      "type": "string"
    },
    "Datum": {
      "description": "The 0.0 of every `axial` reference and of the drawing's dimensions.",
      "oneOf": [
        {
          "const": "bottom_tl",
          "description": "The bottom head's tangent line.",
          "type": "string"
        },
        {
          "const": "bottom_seam",
          "description": "The bottom head-to-shell seam (the end of its straight flange).",
          "type": "string"
        },
        {
          "const": "skirt_base",
          "description": "The underside of the skirt's base ring.",
          "type": "string"
        },
        {
          "const": "plant_elevation",
          "description": "Plant grade: the bottom tangent line sits at `plant_elevation_mm`.",
          "type": "string"
        },
        {
          "const": "left_tl",
          "description": "A horizontal vessel's left tangent line.",
          "type": "string"
        }
      ]
    },
    "DesignData": {
      "description": "Drawing and BOM data only: Triya does no code calculations in the beta.",
      "properties": {
        "capacity_m3": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "code": {
          "description": "`\"ASME VIII-1 2025\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "design_temp_c": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "empty_weight_kg": {
          "description": "Computed values fill the weights when absent.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "hydrotest_kpa": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "joint_eff": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mawp_ext": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pressure"
            },
            {
              "type": "null"
            }
          ]
        },
        "mawp_int": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pressure"
            },
            {
              "type": "null"
            }
          ]
        },
        "mdmt_c": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "nameplate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nameplate"
            },
            {
              "type": "null"
            }
          ]
        },
        "operating_weight_kg": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pwht": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rt": {
          "description": "`\"Spot\"`, `\"Full\"`, `\"None\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "seismic_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_weight_kg": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "wind_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DiameterBasis": {
      "enum": [
        "inside",
        "outside"
      ],
      "type": "string"
    },
    "Element": {
      "description": "One element of the axisymmetric stack.",
      "oneOf": [
        {
          "description": "Cylinder plus base annulus; its top meets the bottom head `top_offset_mm` below the TL.",
          "properties": {
            "base_ring": {
              "$ref": "#/$defs/BaseRing"
            },
            "height_mm": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "skirt",
              "type": "string"
            },
            "top_offset_mm": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "height_mm",
            "base_ring"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cylinder",
              "type": "string"
            },
            "length_mm": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "length_mm"
          ],
          "type": "object"
        },
        {
          "description": "A formed head: straight flange, knuckle, crown.",
          "properties": {
            "crown_radius_mm": {
              "description": "Inside crown radius override (required by `custom_torispherical`).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "kind": {
              "const": "head",
              "type": "string"
            },
            "knuckle_radius_mm": {
              "description": "Inside knuckle radius override (required by `custom_torispherical`).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "orientation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HeadOrientation"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Auto from the head's position in the stack when omitted."
            },
            "preset": {
              "$ref": "#/$defs/HeadPresetId"
            },
            "straight_flange_mm": {
              "description": "Default per preset (≥ 3 t).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "preset"
          ],
          "type": "object"
        },
        {
          "description": "A concentric cone; toriconical when a knuckle is > 0.",
          "properties": {
            "diameter_large_mm": {
              "format": "double",
              "type": "number"
            },
            "diameter_small_mm": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "cone",
              "type": "string"
            },
            "knuckle_large_mm": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "knuckle_small_mm": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "length_mm": {
              "description": "Axial length.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "length_mm",
            "diameter_small_mm",
            "diameter_large_mm"
          ],
          "type": "object"
        },
        {
          "description": "A welded or bolted flat plate (its thickness is the element's `thickness_mm`).",
          "properties": {
            "bolted": {
              "default": false,
              "type": "boolean"
            },
            "kind": {
              "const": "flat_cover",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A weld-neck body flange, from a table row or explicit dimensions.",
          "properties": {
            "explicit": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FlangeDims"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flange_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FlangeRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gasket_gap_mm": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "body_flange",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "diameter_mm": {
          "description": "On the vessel's `diameter_basis`; inherited from the previous element when omitted\n(inheritance stops at a cone, which states both ends).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "description": "`E1`, `E2`, … (unique across elements and attachments).",
          "type": "string"
        },
        "material": {
          "type": [
            "string",
            "null"
          ]
        },
        "thickness_mm": {
          "description": "Wall (or plate) thickness.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "thickness_mm"
      ],
      "type": "object"
    },
    "Facing": {
      "enum": [
        "rf",
        "ff",
        "rtj"
      ],
      "type": "string"
    },
    "Flags": {
      "properties": {
        "boolean_failed": {
          "default": false,
          "description": "The nozzle's cut/join failed in the kernel; it is kept as a separate body.",
          "type": "boolean"
        },
        "unverified_table": {
          "default": false,
          "description": "A dimension came from a table row not marked verified.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "FlangeDims": {
      "description": "A flange given by its dimensions.",
      "properties": {
        "bolt_circle_mm": {
          "format": "double",
          "type": "number"
        },
        "bolt_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bolt_hole_mm": {
          "format": "double",
          "type": "number"
        },
        "hub_len_mm": {
          "format": "double",
          "type": "number"
        },
        "hub_od_mm": {
